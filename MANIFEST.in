# echo-me-skill 发行清单：确保 sdist/wheel 包含完整 Skill 契约载荷，
# 而不只是 tools Python 包（否则 "Installable / Evallable" 声明不成立）。

include SKILL.md
include README.md
include README.zh-CN.md
include LICENSE
include AGENTS.md
include CLAUDE.md
include pyproject.toml

recursive-include prompts *.md
recursive-include agents *.yaml
recursive-include evals *.yaml
recursive-include scripts *.py
recursive-include references *.md
recursive-include examples *.md
recursive-include docs *.md
recursive-include tools *.py

# 示例自画像随包分发，作为中立占位（不含任何真实个人信息）
recursive-include selves *.md *.json